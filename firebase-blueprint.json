{
  "entities": {
    "Invitation": {
      "title": "Invitation",
      "description": "A wedding invitation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groomName": { "type": "string", "maxLength": 128 },
        "brideName": { "type": "string", "maxLength": 128 },
        "weddingDate": { "type": "string", "maxLength": 128 },
        "weddingTime": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 2048 },
        "font": { "type": "string", "maxLength": 64 },
        "background": { "type": "string", "maxLength": 128 },
        "customBackgroundImage": { "type": "string", "maxLength": 2048 },
        "songUrl": { "type": "string", "maxLength": 2048 },
        "showPauseButton": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "groomName", "brideName", "weddingDate", "weddingTime", "message", "font", "background", "showPauseButton", "isActive", "createdAt", "updatedAt"]
    },
    "GuestbookEntry": {
      "title": "GuestbookEntry",
      "description": "An RSVP and congratulation message from a guest",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "guestsCount": { "type": "number" },
        "message": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "guestsCount", "createdAt"]
    }
  },
  "firestore": {
    "/invitations/{inviteId}": {
      "schema": { "$ref": "#/entities/Invitation" },
      "description": "Stores wedding invitations created by the admin"
    },
    "/invitations/{inviteId}/guestbook/{entryId}": {
      "schema": { "$ref": "#/entities/GuestbookEntry" },
      "description": "Stores guest RSVP and congratulation messages for a specific invitation"
    }
  }
}
