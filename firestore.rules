rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin check: Only the Admin is authenticated in this Single-Admin Architecture.
    function isAdmin() {
      return request.auth != null;
    }

    match /invitations/{inviteId} {
      // Guests can read if the invitation is active. Admin can read/write everything.
      allow read: if isAdmin() || resource.data.isActive == true;
      allow write: if isAdmin();

      match /guestbook/{messageId} {
        // Guests can only create new messages (not overwrite). Admin can manage.
        allow read: if isAdmin() || get(/databases/$(database)/documents/invitations/$(inviteId)).data.isActive == true;
        allow create: if !exists(/databases/$(database)/documents/invitations/$(inviteId)/guestbook/$(messageId));
        allow update, delete: if isAdmin();
      }
    }
  }
}
