rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Admin check: Only the Admin is authenticated in this Single-Admin Architecture.
    function isAdmin() {
      return request.auth != null;
    }

    match /invitations/{inviteId} {
      // Anyone can get a specific invitation if they have the ID.
      allow get: if true;
      // Only admins can list all invitations.
      allow list: if isAdmin();
      allow write: if isAdmin();

      match /guestbook/{messageId} {
        // Guests can read the guestbook and create new messages. Admin can manage.
        allow read: if true;
        allow create: if true;
        allow update, delete: if isAdmin();
      }
    }
  }
}
